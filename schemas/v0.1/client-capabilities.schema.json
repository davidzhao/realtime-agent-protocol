{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.salesforce.com/a2a/ext/realtime-agent/v0.1/client-capabilities.schema.json",
  "title": "clientCapabilities message",
  "description": "ROLE_USER message a Live layer MAY send immediately after activation to declare a narrower supported directive set (spec §4.2). The effective directive set is the intersection of this list and the Agent Card list.",
  "type": "object",
  "required": ["role", "metadata", "parts"],
  "properties": {
    "role": { "const": "ROLE_USER" },
    "metadata": {
      "type": "object",
      "required": [
        "https://schemas.salesforce.com/a2a/ext/realtime-agent/v0.1/eventType"
      ],
      "properties": {
        "https://schemas.salesforce.com/a2a/ext/realtime-agent/v0.1/eventType": {
          "const": "clientCapabilities"
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "common.schema.json#/$defs/dataPart" },
          {
            "properties": {
              "data": {
                "type": "object",
                "required": ["directiveTypes"],
                "properties": {
                  "directiveTypes": {
                    "type": "array",
                    "items": { "$ref": "common.schema.json#/$defs/directiveType" },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
